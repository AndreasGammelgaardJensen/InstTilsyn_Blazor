<style>
    .agent-hero { position:sticky; top:0; z-index:30; transition:height .35s ease, padding .35s ease, background .35s ease; backdrop-filter: blur(6px); }
    .agent-hero .hero-main { transition: opacity .3s ease, transform .3s ease; }
    .agent-hero .hero-toolbar { transition: padding .3s ease, gap .3s ease; margin-bottom: 10px }
    .agent-hero .hero-filters { transition: margin .3s ease; }
    .agent-hero.shrunk { padding: .5rem .75rem 0.4rem .75rem; background: rgba(255,255,255,0.85); box-shadow: 0 2px 6px -2px rgba(0,0,0,.25); }
    .agent-hero.shrunk .hero-main { opacity:0; pointer-events:none; height:0; transform: translateY(-10px); }
    .agent-hero.shrunk .hero-toolbar { justify-content:flex-start; }
    .agent-hero.shrunk .hero-filters { margin-top:.25rem; }
    .agent-hero .hero-title, .agent-hero .hero-sub { margin:0; }
    .search-box { min-width: 260px; } .sort-select { width: 140px; }
    .institution-card { transition: transform .25s ease, box-shadow .25s ease; border-radius: 18px; } .institution-card:hover { transform: translateY(-6px); box-shadow: 0 8px 26px -4px rgba(0,0,0,.25); }
    .institution-card .distance-chip { font-weight: 600; }
    .institution-card .mud-icon-button { transition: transform .2s ease; }
    .institution-card .mud-icon-button:hover { transform: scale(1.1); }
    .ellipsis-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .report-table td, .report-table th { white-space: nowrap; }
    .fade-in { animation: fadeIn .35s ease; } @@keyframes fadeIn { from { opacity:0; transform: translateY(4px);} to { opacity:1; transform:translateY(0);} }
    .refresh-fab { position: fixed; bottom: 2rem; right: 2rem; }
    .vertical-institution-list .mud-item { width:100%; } .vertical-institution-list .institution-card { margin-bottom: 1rem; }
    .contact-row { display:flex; flex-wrap:wrap; gap:.75rem; margin-bottom:.5rem; } .contact-item { display:inline-flex; align-items:center; gap:.35rem; font-size:.75rem; background:rgba(0,0,0,.04); padding:.25rem .5rem; border-radius:14px; }
    .virtualizer-wrapper { position:relative; }
    .crit-cell { display:flex; flex-direction:column; line-height:1.1; }
    .crit-cat { font-size:.65rem; font-weight:600; text-transform:uppercase; letter-spacing:.5px; color: var(--mud-palette-primary); }
    @@media (min-width: 600px){ .crit-cat { display:none; } .crit-cell { flex-direction:row; gap:.25rem; } }
    @@media (max-width: 600px){ .toolbar-responsive { flex-direction:column; align-items:stretch; } .search-box { width:100%; } .contact-item { font-size:.70rem; } .institution-card { border-radius:14px; } }
    .mobile-report-list { display:flex; flex-direction:column; gap:1rem; }
    .mobile-report { border:1px solid var(--mud-palette-divider); border-radius:12px; padding:.6rem .8rem; background:var(--mud-palette-surface); box-shadow:0 1px 4px rgba(0,0,0,.08); }
    .crit-mobile-table { width:100%; border-collapse:collapse; }
    .crit-mobile-table th { text-align:left; font-weight:600; font-size:.72rem; padding:.35rem .5rem .35rem 0; width:42%; vertical-align:top; }
    .crit-mobile-table td { font-size:.72rem; padding:.35rem 0 .35rem .25rem; }
    .crit-mobile-table tr:not(:last-child) th, .crit-mobile-table tr:not(:last-child) td { border-bottom:1px solid var(--mud-palette-divider); }
</style>
